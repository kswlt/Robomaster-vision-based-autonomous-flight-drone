<?xml version="1.0" encoding="UTF-8"?>
<!-- Diagnostic transport only; benchmark before adopting for flight. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>vio_diagnostic_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="vio_diagnostic" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>vio_diagnostic_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
