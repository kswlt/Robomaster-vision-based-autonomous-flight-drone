[Unit]
Description=VIO System (D430 + PX4 + OpenVINS)
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/kswlt/vio_ws
ExecStart=/home/orangepi/kswlt/vio_ws/start_vio_systemd.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
