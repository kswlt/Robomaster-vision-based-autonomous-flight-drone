[Unit]
Description=E2E-RL web_vis avoidance dashboard (training-consistent chain)
After=network.target

[Service]
User=orangepi
WorkingDirectory=/home/orangepi/kswlt_e2d
Environment=E2E_MAX_SPEED=1.0
Environment=E2E_RECORD_CSV=/home/orangepi/kswlt_e2d/flight_data.csv
ExecStart=/usr/bin/python3 -u web_vis.py --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
